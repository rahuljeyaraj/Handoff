{
    // Requires a hardware SWD probe (Debug Probe / second Pico running debugprobe).
    // Without one, flash by holding BOOTSEL and dragging build/blink.uf2, or run
    // the "Flash" task. The Pico extension fetches OpenOCD on first debug.
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Pico Debug (Cortex-Debug)",
            "type": "cortex-debug",
            "request": "launch",
            "cwd": "${workspaceFolder}",
            "executable": "${command:raspberry-pi-pico.launchTargetPath}",
            "servertype": "openocd",
            "gdbPath": "${command:raspberry-pi-pico.getGDBPath}",
            "device": "RP2350",
            "configFiles": ["interface/cmsis-dap.cfg", "target/rp2350.cfg"],
            "svdFile": "${userHome}/.pico-sdk/sdk/2.3.1/src/rp2350/hardware_regs/RP2350.svd",
            "runToEntryPoint": "main",
            "openOCDLaunchCommands": ["adapter speed 5000"]
        }
    ]
}
