	(text "Gain 11 x 11 = 121. Firmware holds GP2 high-Z with its input buffer OFF while receiving (RP2350-E9), so R1 does not load or bias the pad."
		(exclude_from_sim no)
		(at 139.7000 172.7200 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "fa75faac-ae20-4109-bb5b-060cf659e178")
	)
	(text "Every JP ships OPEN: bridge with solder to bring the board up one stage at a time (README order); wick off to isolate. No test pad on the 10 MOhm node on purpose."
		(exclude_from_sim no)
		(at 139.7000 175.2600 0)
		(effects
			(font
				(size 1.27 1.27)
			)
