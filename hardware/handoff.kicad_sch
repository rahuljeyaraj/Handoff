	(text "VBUS (USB) and VSYS are OR'd inside the Pico; D1 stops VSYS back-feeding the cell and makes a reversed J1 harmless."
		(exclude_from_sim no)
		(at 15.2400 63.5000 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
