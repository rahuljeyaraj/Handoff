		(uuid "27393afc-4fda-4e7e-9e02-d13606840765")
	)
	(text "~0.35 V drop: VSYS 2.6-3.8 V, Pico needs 1.8-5.5 V. J5 is the charger's plug, wired to the cell, NOT a power input."
		(exclude_from_sim no)
		(at 15.2400 66.0400 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "1ee02e4d-2b31-4450-a20e-400349820f5c")
	)
