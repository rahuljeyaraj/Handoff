<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Compose draws everything; this only has to exist, not have an action
         bar Compose would then have to work around, and paint the window the
         same warm neutral as the surface so nothing flashes before the first
         frame. The dark variant is in values-night. -->
    <style name="Theme.Handoff" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">#FCF9F6</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <!-- What the launcher shows while the process starts. Android 12 always
         draws a splash of its own and cannot place text under its icon, and
         the wearer did not want a page of the hands alone ahead of the real
         one, so this shows the bare surface colour: no icon at all. The
         first frame then brings in the handshake and the wordmark together
         (SplashOverlay). -->
    <style name="Theme.Handoff.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#FCF9F6</item>
        <item name="windowSplashScreenAnimatedIcon">@android:color/transparent</item>
        <item name="postSplashScreenTheme">@style/Theme.Handoff</item>
    </style>
</resources>
