*.uf2
*.elf
*.elf.map
*.bin
*.hex
*.dis
*.map

# ---- CMake --------------------------------------------------------------
CMakeCache.txt
CMakeFiles/
CMakeScripts/
cmake_install.cmake
CTestTestfile.cmake
install_manifest.txt
compile_commands.json
.ninja_deps
.ninja_log
*.ninja

# Generated by pioasm at build time
*.pio.h

# ---- Editors ------------------------------------------------------------
# Keep the shared, path-portable configs; drop everything machine-generated.
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/launch.json
!.vscode/tasks.json
!.vscode/cmake-kits.json
.vscode/ipch/
.idea/
*.code-workspace

# ---- Host tooling (Python plotter, docs 10.5) ---------------------------
__pycache__/
*.py[cod]
.venv/
venv/
env/
.pytest_cache/
*.egg-info/

# ---- Test vectors and captures ------------------------------------------
# Generated vectors are derived from tools/gen_vectors.py and regenerated by
# every test run, so they must NOT be committed: a stale one would silently
# stop matching a changed HANDOFF_GZ_N and the cross-check would pass anyway.
firmware/test/vectors/generated/

# Hardware captures are the opposite case and ARE committed. Development plan
# section 1: a capture that broke the decoder on the bench is replayed in CI
# forever, and the bug is not fixed until it is a regression test. They are
# also irreplaceable — you cannot re-record the moment a link failed on a real
# body — so the blanket rules below must not swallow them.
!firmware/test/vectors/captures/
!firmware/test/vectors/captures/**

# Ad-hoc dumps from the bench, before they are adopted by tools/replay.py.
captures/
*.npy
*.raw

# ---- OS -----------------------------------------------------------------
Thumbs.db
ehthumbs.db
desktop.ini
.DS_Store
*~
*.swp

