# ---- Build output -------------------------------------------------------
build/
build-*/
cmake-build-*/

# Firmware artifacts (regenerated by every build)
*.uf2
*.elf
*.elf.map
*.bin
*.hex
*.dis
*.map

# ---- CMake --------------------------------------------------------------
CMakeCache.txt
CMakeFiles/
CMakeScripts/
cmake_install.cmake
CTestTestfile.cmake
install_manifest.txt
compile_commands.json
.ninja_deps
.ninja_log
*.ninja

# Generated by pioasm at build time
*.pio.h

# ---- Editors ------------------------------------------------------------
# Keep the shared, path-portable configs; drop everything machine-generated.
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/launch.json
!.vscode/tasks.json
!.vscode/cmake-kits.json
.vscode/ipch/
.idea/
*.code-workspace

# ---- Host tooling (Python plotter, docs 10.5) ---------------------------
__pycache__/
*.py[cod]
.venv/
venv/
env/
.pytest_cache/
*.egg-info/

# ---- Capture data -------------------------------------------------------
# Raw ADC dumps are large and reproducible; keep them out of git.
captures/
*.npy
*.raw

# ---- OS -----------------------------------------------------------------
Thumbs.db
ehthumbs.db
desktop.ini
.DS_Store
*~
*.swp
